<?xml version="1.0" encoding="utf-8"?>
<!-- Pantry card: category icon, name, quantity with a category chip, and an expiry badge
     on the right for anything expiring soon or already expired. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_md"
    android:layout_marginVertical="5dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingVertical="14dp"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="14dp">

        <FrameLayout
            android:id="@+id/icon_circle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/shape_status_dot">

            <ImageView
                android:id="@+id/iv_category_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                tools:srcCompat="@drawable/ic_category_vegetables" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_item_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Dijong.TitleMedium"
                android:textColor="@color/ink"
                tools:text="Butternut" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_item_quantity_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/ink_muted"
                    tools:text="800 g" />

                <TextView
                    android:id="@+id/tv_category_chip"
                    style="@style/Widget.Dijong.Pill"
                    android:layout_marginStart="@dimen/space_sm"
                    tools:text="Vegetables" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tv_expiry_badge"
            style="@style/Widget.Dijong.Pill"
            android:layout_marginStart="@dimen/space_sm"
            android:paddingVertical="4dp"
            android:textAppearance="@style/TextAppearance.Dijong.Badge"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_clock_small"
            tools:text="Tomorrow"
            tools:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
