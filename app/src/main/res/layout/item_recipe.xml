<?xml version="1.0" encoding="utf-8"?>
<!-- Ready-to-cook card: teal pot tile, name, ingredient count with a "You have everything"
     pill, and a chevron to the recipe. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="14dp"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_rounded_12"
            android:backgroundTint="@color/teal_container">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_pot"
                app:tint="@color/teal" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_item_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Dijong.TitleMedium"
                android:textColor="@color/ink"
                tools:text="Pampoensop (Butternut Soup)" />

            <TextView
                android:id="@+id/tv_ingredient_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/ink_muted"
                android:textSize="13sp"
                tools:text="5 ingredients" />

            <TextView
                style="@style/Widget.Dijong.Pill"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/teal"
                android:paddingHorizontal="8dp"
                android:text="@string/you_have_everything"
                android:textColor="@color/white"
                app:drawableStartCompat="@drawable/ic_check_small"
                app:drawableTint="@color/white" />

        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/space_sm"
            android:contentDescription="@null"
            app:srcCompat="@drawable/ic_chevron_right"
            app:tint="@color/ink_muted" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
