<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Dijong" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>

        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorSecondaryVariant">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/brand_on_secondary</item>

        <item name="colorSurface">@color/surface_container</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:colorBackground">@color/surface</item>

        <item name="android:statusBarColor" tools:targetApi="l">@color/brand_primary_dark</item>

        <!-- Poppins everywhere by default; specific TextAppearances in type.xml refine per role. -->
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="fontFamily">@font/poppins_regular</item>

        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Dijong.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Dijong.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Dijong.TitleLarge</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Dijong.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Dijong.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Dijong.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Dijong.LabelLarge</item>

        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Dijong.MediumComponent</item>
        <item name="materialCardViewStyle">@style/Widget.Dijong.CardView</item>
    </style>

    <style name="Theme.Dijong.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />

    <style name="Theme.Dijong.PopupOverlay" parent="ThemeOverlay.Material3.Light" />

    <style name="ShapeAppearance.Dijong.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/card_corner_radius</item>
    </style>

    <style name="Widget.Dijong.SectionHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">@dimen/space_md</item>
        <item name="android:paddingTop">@dimen/space_md</item>
        <item name="android:paddingBottom">@dimen/space_xs</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Widget.Dijong.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface_container</item>
    </style>
</resources>
