<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dijong is a light-only design: cream background, plum bars, white cards. -->
    <style name="Theme.Dijong" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/plum</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/teal_container</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>

        <item name="colorSecondary">@color/teal</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Bottom navigation's active pill uses the secondary container colours -->
        <item name="colorSecondaryContainer">@color/teal_container</item>
        <item name="colorOnSecondaryContainer">@color/teal</item>

        <item name="colorTertiary">@color/amber</item>
        <item name="colorOnTertiary">@color/ink</item>

        <item name="colorSurface">@color/cream</item>
        <item name="colorSurfaceContainer">@color/card</item>
        <item name="colorSurfaceContainerHigh">@color/card</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_muted</item>
        <item name="colorOutline">@color/field_outline</item>
        <item name="colorOutlineVariant">@color/hairline</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/cream</item>

        <item name="homeAsUpIndicator">@drawable/ic_back_on_plum</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/plum</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Poppins everywhere by default; specific TextAppearances in type.xml refine per role. -->
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="fontFamily">@font/poppins_regular</item>

        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Dijong.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Dijong.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Dijong.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Dijong.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Dijong.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Dijong.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Dijong.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Dijong.LabelLarge</item>

        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Dijong.MediumComponent</item>
        <item name="materialCardViewStyle">@style/Widget.Dijong.CardView</item>
        <item name="textInputStyle">@style/Widget.Dijong.TextInputLayout</item>
        <item name="snackbarStyle">@style/Widget.Dijong.Snackbar</item>
        <item name="snackbarButtonStyle">@style/Widget.Dijong.SnackbarButton</item>
        <item name="snackbarTextViewStyle">@style/Widget.Dijong.SnackbarText</item>
        <item name="bottomNavigationStyle">@style/Widget.Dijong.BottomNavigation</item>
        <item name="floatingActionButtonStyle">@style/Widget.Dijong.Fab</item>
        <item name="materialButtonStyle">@style/Widget.Dijong.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Dijong.Button.Outlined</item>
    </style>

    <style name="Theme.Dijong.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />

    <style name="Theme.Dijong.PopupOverlay" parent="ThemeOverlay.Material3.Light" />

    <!-- Plum top bar: large title with an optional muted subtitle, as on the main tabs -->
    <style name="Widget.Dijong.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/plum</item>
        <item name="titleTextAppearance">@style/TextAppearance.Dijong.ToolbarTitle</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.Dijong.ToolbarSubtitle</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/plum_soft_text</item>
        <item name="titleMarginStart">@dimen/space_md</item>
    </style>

    <!-- Top bar for the pushed screens (add, edit, recipe): back arrow and a 20sp title -->
    <style name="Widget.Dijong.Toolbar.Detail">
        <item name="titleTextAppearance">@style/TextAppearance.Dijong.DetailTitle</item>
        <item name="titleMarginStart">@dimen/space_xs</item>
    </style>

    <style name="ShapeAppearance.Dijong.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/card_corner_radius</item>
    </style>

    <style name="Widget.Dijong.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/hairline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/card</item>
    </style>

    <style name="Widget.Dijong.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/field_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/field_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/field_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/field_corner_radius</item>
        <item name="boxStrokeColor">@color/field_stroke</item>
        <item name="boxStrokeErrorColor">@color/error</item>
        <item name="hintTextColor">@color/plum</item>
        <item name="errorIconDrawable">@drawable/ic_error</item>
        <item name="errorTextColor">@color/error</item>
        <item name="errorIconTint">@color/error</item>
        <item name="placeholderTextColor">@color/field_placeholder</item>
    </style>

    <style name="Widget.Dijong.TextInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">@dimen/field_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/field_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/field_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/field_corner_radius</item>
        <item name="boxStrokeColor">@color/field_stroke</item>
        <item name="hintTextColor">@color/plum</item>
        <item name="endIconDrawable">@drawable/ic_chevron_down</item>
        <item name="endIconTint">@color/ink_muted</item>
    </style>

    <style name="Widget.Dijong.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Dijong.Button</item>
        <item name="backgroundTint">@color/plum</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.Dijong.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Dijong.Button</item>
        <item name="android:textColor">@color/plum</item>
        <item name="iconTint">@color/plum</item>
        <item name="strokeColor">@color/field_outline</item>
    </style>

    <!-- Red outline for destructive actions (Delete ingredient) -->
    <style name="Widget.Dijong.Button.Destructive" parent="Widget.Dijong.Button.Outlined">
        <item name="android:textColor">@color/error</item>
        <item name="iconTint">@color/error</item>
        <item name="strokeColor">@color/error</item>
    </style>

    <style name="Widget.Dijong.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/plum</item>
        <item name="tint">@color/white</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Dijong.Fab</item>
    </style>

    <style name="ShapeAppearance.Dijong.Fab" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Widget.Dijong.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/card</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Dijong.NavLabel.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Dijong.NavLabel</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Dijong.NavIndicator</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.Dijong.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/teal_container</item>
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
    </style>

    <style name="Widget.Dijong.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/snackbar</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Dijong.Snackbar</item>
    </style>

    <style name="ShapeAppearance.Dijong.Snackbar" parent="">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Widget.Dijong.SnackbarButton" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textColor">@color/snackbar_action</item>
        <item name="android:textAppearance">@style/TextAppearance.Dijong.Button</item>
    </style>

    <style name="Widget.Dijong.SnackbarText" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textColor">@color/cream</item>
        <item name="android:textAppearance">@style/TextAppearance.Dijong.BodyMedium</item>
    </style>

    <!-- Rounded pill: expiry badges, category chips and "You have everything" -->
    <style name="Widget.Dijong.Pill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">2dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Dijong.Pill</item>
    </style>

    <style name="Widget.Dijong.SectionHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">@dimen/space_md</item>
        <item name="android:paddingTop">@dimen/space_md</item>
        <item name="android:paddingBottom">@dimen/space_xs</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
</resources>
