<?xml version="1.0" encoding="utf-8"?>
<!-- Outlined field border: plum while focused, muted grey otherwise -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/plum" android:state_focused="true" />
    <item android:color="@color/plum" android:state_hovered="true" />
    <item android:color="@color/field_outline" />
</selector>
